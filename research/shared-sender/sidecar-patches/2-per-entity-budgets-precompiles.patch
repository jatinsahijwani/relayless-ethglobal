+    const gas = verifyGasByEntity(asTx(frames), recognizeValidationPrefix(frames, sender)!);
+    expect(gas.get(getAddress(payer))).toBe(110_000n);
+    expect(gas.get(getAddress(sender))).toBe(50_000n);
+  });
