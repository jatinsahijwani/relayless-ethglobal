 export type StructuralRulesResult = { valid: true } | { valid: false; reason: string };
 
+/**
+ * ERC-8421 BUDGET-010: validation gas per entity, as checksummed address to the
+ * sum of `limits.execution` over that entity's own validation frames.
+ *
+ * Every frame in `prefix.frames` carries the role it is attributed to: a
+ * `pre_verify` frame already carries the role of the approving frame it
+ * immediately precedes, as BUDGET-010 requires, and the `deploy` frame is the
+ * factory's. A leading `expiry_verify` frame is not in `prefix.frames`, and
+ * the ERC attributes it to no entity ("its code is protocol-defined"), so it
+ * counts toward none. The signatures' intrinsic cost counts toward `tx.sender`.
+ */
+export function verifyGasByEntity(tx: FrameTransaction, prefix: ValidationPrefixMatch): Map<string, bigint> {
+  const sender = getAddress(tx.sender);
+  const gas = new Map<string, bigint>([[sender, signatureVerificationCost(tx)]]);
+  for (const { frame, role } of prefix.frames) {
+    const entity = role === "sender" ? sender : resolvedTarget(frame.target, tx.sender);
+    gas.set(entity, (gas.get(entity) ?? BigInt(0)) + frame.limits.execution);
+  }
+  return gas;
+}
+
+export type EntityBudgets = { unstaked: bigint; staked: bigint };
+
+/**
+ * ERC-8421 BUDGET-010's check: each entity's sum against its own budget, the
+ * larger one if it is staked. Returns the rejection reason, or null.
+ */
+export async function findEntityOverBudget(
+  gasByEntity: Map<string, bigint>,
+  isStaked: (entity: string) => Promise<boolean>,
+  budgets: EntityBudgets
+): Promise<string | null> {
+  for (const [entity, gas] of gasByEntity) {
+    if (gas <= budgets.unstaked) continue;
+    const staked = await isStaked(entity);
+    const budget = staked ? budgets.staked : budgets.unstaked;
+    if (gas > budget) {
+      return `${staked ? "staked" : "unstaked"} entity ${entity} validation gas ${gas} exceeds its budget ${budget} (ERC-8421 BUDGET-010)`;
+    }
+  }
+  return null;
+}
