+describe("verifyGasByEntity (ERC-8421 BUDGET-010)", () => {
+  const sender = "0x1111111111111111111111111111111111111111" as const;
+  const payer = "0x2222222222222222222222222222222222222222" as const;
+  const verify = (flags: number, target: `0x${string}` | null, execution: bigint): Frame => ({
+    mode: FRAME_MODE.VERIFY, flags, target, limits: { execution, state: 0n }, value: 0n, data: "0x",
+  });
+  const asTx = (frames: Frame[], signatures: FrameTransaction["signatures"] = []) =>
+    ({ sender, frames, signatures }) as unknown as FrameTransaction;
+
+  it("counts a self-relay's frames and signature cost toward the sender", () => {
+    const frames = [verify(3, null, 300_000n)];
+    const tx = asTx(frames, [{ scheme: 0, signer: "0x", msg: "0x", signature: "0x" }]);
+    const gas = verifyGasByEntity(tx, recognizeValidationPrefix(frames, sender)!);
+    expect(gas.get(getAddress(sender))).toBe(300_100n);
+    expect(gas.size).toBe(1);
+  });
+
+  it("keeps a separate budget for the sender and the payer", () => {
+    const frames = [verify(2, null, 80_000n), verify(1, payer, 90_000n)];
+    const gas = verifyGasByEntity(asTx(frames), recognizeValidationPrefix(frames, sender)!);
+    expect(gas.get(getAddress(sender))).toBe(80_000n);
+    expect(gas.get(getAddress(payer))).toBe(90_000n);
+  });
+
+  it("does not apply the single 100k cap when the caller enforces per-entity budgets", () => {
+    const frames = [verify(3, null, 300_000n)];
+    const prefix = recognizeValidationPrefix(frames, sender)!;
+    expect(validateStructuralRules(asTx(frames), prefix).valid).toBe(false);
+    expect(validateStructuralRules(asTx(frames), prefix, { perEntityBudgets: true }).valid).toBe(true);
+  });
+});
