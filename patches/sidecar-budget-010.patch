+/**
+ * ERC-8421 BUDGET-010: validation gas per entity, as checksummed address to the
+ * sum of `limits.execution` over that entity's own validation frames. The
+ * signature cost and any frame without a role (a leading `expiry_verify`) count
+ * toward `tx.sender`.
+ */
+export function verifyGasByEntity(tx: FrameTransaction, prefix: ValidationPrefixMatch): Map<string, bigint> {
+  const sender = getAddress(tx.sender);
+  const gas = new Map<string, bigint>([[sender, signatureVerificationCost(tx)]]);
+  const lastPrefixIndex = Math.max(...prefix.frames.map((f) => f.frameIndex));
+  for (let i = 0; i <= lastPrefixIndex; i++) {
+    const frame = tx.frames[i];
+    const match = prefix.frames.find((f) => f.frameIndex === i);
+    const entity = match && match.role !== "sender" ? resolvedTarget(frame.target, tx.sender) : sender;
+    gas.set(entity, (gas.get(entity) ?? BigInt(0)) + frame.limits.execution);
+  }
+  return gas;
+}
