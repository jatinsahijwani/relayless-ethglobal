+    /// Hegotá (FOCIL): payload attributes carry the inclusion list. The dev producer has no
+    /// inclusion list to enforce, so it sends an empty one.
+    pub async fn engine_forkchoice_updated_v5(
+        &self,
+        state: ForkChoiceState,
+        payload_attributes: Option<PayloadAttributesV5>,
+    ) -> Result<ForkChoiceResponse, EngineClientError> {
+        let request = RpcRequest::from(ForkChoiceUpdatedV5 {
+            fork_choice_state: state,
+            payload_attributes,
+            custody_columns: None,
+        });
+        match self.send_request(request).await? {
+            RpcResponse::Success(result) => serde_json::from_value(result.result)
+                .map_err(ForkChoiceUpdatedError::SerdeJSONError)
+                .map_err(EngineClientError::from),
+            RpcResponse::Error(error_response) => {
+                Err(ForkChoiceUpdatedError::RPCError(error_response.error.message.to_string()).into())
+            }
+        }
+    }
+
+    /// Hegotá payloads must be imported with newPayloadV6, which carries the inclusion list.
+    pub async fn engine_new_payload_v6(
+        &self,
+        execution_payload: ExecutionPayload,
+        expected_blob_versioned_hashes: Vec<H256>,
+        parent_beacon_block_root: H256,
+    ) -> Result<PayloadStatus, EngineClientError> {
+        let request = NewPayloadV6Request {
+            payload: execution_payload,
+            expected_blob_versioned_hashes,
+            parent_beacon_block_root,
+            execution_requests: vec![],
+            inclusion_list_transactions: vec![],
+            raw_bal_hash: None,
+        }
+        .into();
+        match self.send_request(request).await? {
+            RpcResponse::Success(result) => serde_json::from_value(result.result)
+                .map_err(NewPayloadError::SerdeJSONError)
+                .map_err(EngineClientError::from),
+            RpcResponse::Error(error_response) => {
+                Err(NewPayloadError::RPCError(error_response.error.message.to_string()).into())
+            }
+        }
+    }
