# Devnet only. Never put a key here that holds anything of value.
DEPLOYER_KEY=0x
# Signs the association set's root. Devnet only.
ASP_KEY=0x

# ENSv2 on Sepolia (docs/ens-research.md). Throwaway keys only. ASP_KEY above is also the ASP's operator there.
# Curator: registers relayless.eth and ASP names.
SEPOLIA_DEPLOYER_KEY=0x
# Owns the World ID ASP's name and resolver. Kept apart from the operator, which is a hot key on the server.
ASP_OWNER_KEY=0x
# The ASP server publishes its root to <this label>.<directory> when set. Off if empty, and the approved set works the same.
ASP_ENS_LABEL=
# Used only by the end-to-end test: the recipient of a private receive name, and the app key it grants a role to.
E2E_ALICE_KEY=0x
E2E_APP_KEY=0x

# World ID (docs/world-id-setup.md). The signing key is a secret: the server reads it, the browser never sees it.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
